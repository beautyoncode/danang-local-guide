# Copy to .env for a local sync run: `npm run sync -- --dry-run`
# .env is gitignored. Never commit a real token.

# Internal integration secret from notion.so/my-integrations.
# The integration must ALSO be connected to the parent page (page ⋯ → Connections).
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DATA SOURCE ids, not database ids:
#   curl -s https://api.notion.com/v1/databases/<database_id> \
#     -H "Authorization: Bearer $NOTION_TOKEN" -H "Notion-Version: 2026-03-11" \
#     | jq -r '.data_sources[0].id'
NOTION_PLACES_DS_ID=
NOTION_EXPERIENCES_DS_ID=
NOTION_NEIGHBORHOODS_DS_ID=
